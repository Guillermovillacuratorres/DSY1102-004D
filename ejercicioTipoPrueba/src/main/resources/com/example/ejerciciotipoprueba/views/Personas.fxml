<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ejerciciotipoprueba.controller.PersonaController">
   <children>
      <Label layoutX="53.0" layoutY="94.0" text="Edad:" />
      <Label layoutX="44.0" layoutY="123.0" text="Nombre:" />
      <Label layoutX="39.0" layoutY="235.0" text="Titulo:" />
      <CheckBox fx:id="chbCasado" layoutX="98.0" layoutY="183.0" mnemonicParsing="false" text="Casado" />
      <ComboBox fx:id="cmbTipo" layoutX="98.0" layoutY="47.0" onAction="#cambiarTipo" prefWidth="150.0" />
      <Label layoutX="55.0" layoutY="51.0" text="Tipo" />
      <TextField fx:id="txtEdad" layoutX="99.0" layoutY="90.0" />
      <TextField fx:id="txtNombre" layoutX="99.0" layoutY="128.0" />
      <TextField fx:id="txtTitulo" layoutX="84.0" layoutY="231.0" />
      <TextField fx:id="txtSueldo" layoutX="84.0" layoutY="281.0" />
      <TextField fx:id="txtNivel" layoutX="84.0" layoutY="323.0" />
      <Label layoutX="39.0" layoutY="285.0" text="Sueldo:" />
      <Label layoutX="39.0" layoutY="327.0" text="Nivel:" />
      <Button layoutX="148.0" layoutY="361.0" mnemonicParsing="false" onAction="#agregar" text="Agregar" />
      <Button layoutX="525.0" layoutY="323.0" mnemonicParsing="false" onAction="#eliminar" text="Eliminar" />
      <TableView fx:id="tblPersonas" layoutX="284.0" layoutY="41.0" prefHeight="267.0" prefWidth="309.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="73.0" text="ID" />
          <TableColumn fx:id="colNombre" prefWidth="77.0" text="NOMBRE" />
            <TableColumn fx:id="colCasado" prefWidth="75.0" text="Casado" />
            <TableColumn fx:id="colEdad" prefWidth="75.0" text="Edad" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
